# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_very_long_secret_key_at_least_256_bits_long_here
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
# Generate with: openssl rand -base64 32
OTP_HMAC_SECRET=your_hmac_secret_32_chars_minimum

# Rate Limit
RATE_LIMIT_TRUSTED_PROXIES=

# SendGrid
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME=ECommerce

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=your_whatsapp_from_number

# Cors
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:8080/login/oauth2/code/facebook

# Cloudflare R2 Storage (S3 Compatible)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=your_r2_public_url

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your-model

# Payment Gateways
PAYMENT_FRONTEND_URL=http://localhost:5173
PAYMENT_VNPAY_TMN_CODE=your_vnpay_tmn_code
PAYMENT_VNPAY_HASH_SECRET=your_vnpay_hash_secret
PAYMENT_MOMO_PARTNER_CODE=your_momo_partner_code
PAYMENT_MOMO_ACCESS_KEY=your_momo_access_key
PAYMENT_MOMO_SECRET_KEY=your_momo_secret_key
PAYMENT_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYMENT_PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYMENT_STRIPE_SECRET_KEY=your_stripe_secret_key
PAYMENT_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
PAYMENT_STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
PAYMENT_ZALOPAY_APP_ID=your_zalopay_app_id
PAYMENT_ZALOPAY_KEY1=your_zalopay_key1
PAYMENT_ZALOPAY_KEY2=your_zalopay_key2

# Admin Bootstrap (Run once for production setup)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=your_secure_password_at_least_12_chars